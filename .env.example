NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Se usa para armar los links absolutos de los correos. En Vercel tiene que ser
# la URL real del sitio, no localhost, o los avisos llegan con links rotos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# RESEND_API_KEY=   # added in epic 1.6
# Remitente de los correos transaccionales. SIN esto se usa el compartido
# onboarding@resend.dev, que solo entrega al dueño de la cuenta de Resend: todos
# los demás envíos fallan con 403 y sendTransactionalEmail se los traga en
# silencio. Para que los correos lleguen de verdad hay que verificar el dominio
# en resend.com/domains y poner acá una dirección de ese dominio.
# RESEND_FROM_EMAIL=UGC·CRC <hola@qlabsmethod.com>
# Transcripción de videos en /ugc/creador/transcripcion. Gemini 2.5 Flash recibe
# la URL del video directamente, así que NO hacen falta yt-dlp ni ffmpeg.
# GEMINI_API_KEY=

# --- Agente de recordatorios por WhatsApp (Q·OS) ---
# Sin estas variables el agente no manda nada y lo loguea; no rompe la app.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# El número emisor. En desarrollo es el del Twilio Sandbox for WhatsApp, que
# funciona sin esperar la aprobación de Meta: cada quien le manda "join <clave>"
# desde su celular y ya recibe mensajes de prueba.
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# ContentSid (HX...) de la plantilla aprobada del recordatorio diario. Las
# plantillas se crean en el Content Template Builder de Twilio y las aprueba
# Meta (24-48 h). Categoría "utility" — es la barata y la que corresponde.
# TWILIO_REMINDER_CONTENT_SID=
# Protege /api/qos/agente/cron. En Vercel, definirla hace que el cron mande
# sola la cabecera Authorization: Bearer <valor>. Sin esta variable el endpoint
# devuelve 503 en vez de quedar abierto.
# CRON_SECRET=
