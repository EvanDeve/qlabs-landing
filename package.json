    "@vercel/analytics": "^2.0.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "gsap": "^3.15.0",
    "jsqr": "^1.4.0",
    "next": "16.2.10",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
